# ArcReel 单客户实例配置。复制为 .env 后填写；.env 含密钥，不要提交到版本库。

# ---- 实例标识 ----
# 客户短名（小写字母、数字、中划线），用作 Compose 项目名与 SSO client_id 后缀
CUSTOMER_SLUG=alice
# 宿主机回环端口，每个客户不同，反向代理转发到这里
ARCREEL_PORT=12401

# ---- 本地登录（运维兜底） ----
AUTH_USERNAME=admin
# 强密码；只交给运维，不交给客户
AUTH_PASSWORD=
# 长期固定的随机值（openssl rand -hex 32），变更后所有登录失效
AUTH_TOKEN_SECRET=

# ---- new-api 统一账号登录 ----
# ArcReel 服务端访问 new-api 的地址（可走内网）
NEWAPI_BASE_URL=https://api.example.com
# 浏览器访问 new-api 的地址；与上面相同可留空
NEWAPI_PUBLIC_URL=
# new-api 的 SSOClients 里登记的 client_id，与 secret 明文（new-api 只存 sha256）
NEWAPI_CLIENT_ID=arcreel-alice
NEWAPI_CLIENT_SECRET=
# 必须与 SSO 客户端 redirect_uris 中的一项完全一致
NEWAPI_REDIRECT_URI=https://alice.arcreel.example.com/sso/callback
# 可选：实例侧第二道名单（逗号分隔的 new-api 用户 id），应与 SSO 客户端的 allowed_user_ids 一致
# NEWAPI_ALLOWED_USER_IDS=
# 可选：首次用 new-api 登录且实例还没有任何供应商时，把登录返回的 API 密钥
# 存为指向 NEWAPI_BASE_URL/v1 的自定义供应商「new-api」
NEWAPI_AUTO_PROVIDER=true

# LOG_LEVEL=INFO
